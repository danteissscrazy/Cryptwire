<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- packages.lock.json fija la versión y el hash de cada paquete: si NuGet sirve otro contenido, la
         restauración falla (NU1403). Los avisos de vulnerabilidad (NuGetAudit) ya son errores por
         TreatWarningsAsErrors. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Authors>Cryptwire contributors</Authors>
    <Company>Cryptwire</Company>
  </PropertyGroup>

  <!-- Release: ninguna ruta local (C:\Users\...) dentro de los binarios que se distribuyen. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>
</Project>
