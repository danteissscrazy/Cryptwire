<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- packages.lock.json fija la versión y el hash de cada paquete: si NuGet sirve otro contenido, la
         restauración falla (NU1403). Los avisos de vulnerabilidad (NuGetAudit) ya son errores por
         TreatWarningsAsErrors. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Authors>Cryptwire contributors</Authors>
    <Company>Cryptwire</Company>
    <Version>1.0.1</Version>
    <!-- Sin Source Link: metería en el .pdb la dirección del repo (y el nombre de su cuenta), y el .dll
         cambiaría según el remoto de cada clon, así que dejaría de ser reproducible. El commit sigue en la
         versión del producto. -->
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>

  <!-- Release: ninguna ruta local (C:\Users\...) dentro de los binarios que se distribuyen. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>
</Project>
