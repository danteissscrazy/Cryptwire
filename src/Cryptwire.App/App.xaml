<Application x:Class="Cryptwire.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Lo que comparten la ventana, los widgets y los ajustes. Los colores (Cw.*) los pone PaletteResources
         según la piel activa. -->
    <Application.Resources>
        <FontFamily x:Key="MetaFont">pack://application:,,,/Fuentes/#Share Tech Mono</FontFamily>
        <FontFamily x:Key="TitleFont">pack://application:,,,/Fuentes/#Cinzel</FontFamily>

        <!-- Conmutador: pista de hielo con botón de oro cuando está encendido; apagado, gris. -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="38" Height="18" Background="Transparent">
                            <Border x:Name="Track" Background="{DynamicResource Cw.Line}" CornerRadius="2" />
                            <Border x:Name="Knob" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left"
                                    Background="{DynamicResource Cw.Faint}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Cw.GlowEdge}" />
                                <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Cw.Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Cw.Glow}" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Conmutador pequeño para la barra de widgets. -->
        <Style x:Key="SmallSwitch" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="30" Height="14" Background="Transparent">
                            <Border x:Name="Track" Background="{DynamicResource Cw.Line}" CornerRadius="1" />
                            <Border x:Name="Knob" Width="9" Height="9" Margin="2.5,0" HorizontalAlignment="Left"
                                    Background="{DynamicResource Cw.Faint}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Cw.GlowEdge}" />
                                <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Cw.Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
