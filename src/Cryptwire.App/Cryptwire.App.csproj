<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Solo por el icono de la bandeja (NotifyIcon): WPF no trae uno. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Cryptwire</AssemblyName>
    <Product>Cryptwire</Product>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Windows Forms se usa por su nombre completo: así sus Application, Button o Color no chocan con los de WPF. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Logo y fuentes de la ventana, dentro del ejecutable. Se regeneran con los scripts de tools/. -->
  <ItemGroup>
    <Resource Include="Assets\logo.ico" />
    <Resource Include="Assets\*.png" />
    <Resource Include="Fuentes\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cryptwire.Core\Cryptwire.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <!-- Las pieles viajan junto al ejecutable, en themes\. -->
  <ItemGroup>
    <Content Include="..\..\themes\**\*" LinkBase="themes" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
