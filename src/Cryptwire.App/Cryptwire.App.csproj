<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Solo por el icono de la bandeja (NotifyIcon): WPF no trae uno. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Cryptwire</AssemblyName>
    <Product>Cryptwire</Product>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <!-- El instalador lleva .NET dentro (publicar.ps1 publica para win-x64 con el runtime). Con el RID en
         plural, los packages.lock.json incluyen también los paquetes de win-x64 sin cambiar la carpeta de
         bin\ de siempre. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Los mensajes de .NET, WPF y Windows Forms solo en español (y el inglés de serie). -->
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <!-- Lo que se distribuye va sin .pdb: a quien instala no le sirve. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- Como con las variables WEBVIEW2_*: una DOTNET_STARTUP_HOOKS que sobrara de algo metería otro
         ensamblado dentro de Cryptwire, con tu sesión de WhatsApp abierta. -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <!-- Windows Forms se usa por su nombre completo: así sus Application, Button o Color no chocan con los de WPF. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Logo y fuentes de la ventana, dentro del ejecutable. Se regeneran con los scripts de tools/. -->
  <ItemGroup>
    <Resource Include="Assets\logo.ico" />
    <Resource Include="Assets\*.png" />
    <Resource Include="Fuentes\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cryptwire.Core\Cryptwire.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <!-- Las pieles viajan junto al ejecutable, en themes\. -->
  <ItemGroup>
    <Content Include="..\..\themes\**\*" LinkBase="themes" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
