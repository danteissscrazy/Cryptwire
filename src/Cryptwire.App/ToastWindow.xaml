<Window x:Class="Cryptwire.App.ToastWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cryptwire"
        Width="372" Height="108"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- Un aviso de Cryptwire: placa de esquinas cortadas como las burbujas de la piel, las cuchillas con la
         inicial del chat y el filo del color de la piel. Los colores son los de la piel activa (Cw.*). -->
    <Grid x:Name="Root" Cursor="Hand" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" X="28" />
        </Grid.RenderTransform>

        <Path x:Name="Edge" Data="M10,0 H372 V98 L362,108 H0 V10 Z" Fill="{DynamicResource Cw.AccentEdge}" />
        <Path Data="M10.4,1 H371 V97.6 L361.6,107 H1 V10.4 Z" Fill="{DynamicResource Cw.Panel}" />
        <Rectangle x:Name="KindBar" Width="2" HorizontalAlignment="Left" Margin="1,16,0,16"
                   Fill="{DynamicResource Cw.Glow}" />

        <Grid Margin="16,11,8,11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Canvas x:Name="Avatar" Grid.Column="0" Width="46" Height="46" HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="KindLabel" FontFamily="pack://application:,,,/Fuentes/#Share Tech Mono"
                           FontSize="10.5" Foreground="{DynamicResource Cw.Accent}" />
                <TextBlock x:Name="TitleText" Margin="0,2,0,0" FontSize="15.5" FontWeight="SemiBold"
                           FontFamily="pack://application:,,,/Fuentes/#Cinzel"
                           Foreground="{DynamicResource Cw.Text}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="BodyText" Margin="0,2,0,0" FontFamily="Segoe UI" FontSize="12.5"
                           Foreground="{DynamicResource Cw.Soft}" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="18"
                           LineStackingStrategy="BlockLineHeight" />
            </StackPanel>

            <Button x:Name="CloseButton" Grid.Column="2" Width="26" Height="26" VerticalAlignment="Top"
                    Margin="4,-3,0,0" Cursor="Arrow" Focusable="False" ToolTip="Cerrar"
                    Foreground="{DynamicResource Cw.Faint}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Cw.GlowHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Cw.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>
