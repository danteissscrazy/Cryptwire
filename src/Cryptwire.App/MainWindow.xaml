<Window x:Class="Cryptwire.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:app="clr-namespace:Cryptwire.App"
        Title="Cryptwire"
        Icon="Assets/logo.ico"
        Width="1280" Height="820"
        MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Cw.Background}">

    <!-- Sin el marco de Windows: la barra de título es nuestra. Windows sigue encargándose de mover,
         redimensionar, ajustar a los bordes y del menú de la ventana con clic derecho. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Con mensajes sin leer, el botón de la barra de tareas lleva el número encima (lo pone el código). -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>

    <!-- Colores de la piel activa: Cw.* (ver PaletteResources). -->
    <Window.Resources>
        <FontFamily x:Key="MetaFont">pack://application:,,,/Fuentes/#Share Tech Mono</FontFamily>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Foreground" Value="{DynamicResource Cw.Soft}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Cw.GlowHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Cw.Text}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Cw.GlowPress}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Maximizar: Windows le manda el ratón como si fuera su botón (para el panel de diseños de ajuste de
             Windows 11), así que el estado lo pone el código en Tag en vez de IsMouseOver. -->
        <Style x:Key="MaximizeButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="hover">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Cw.GlowHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Cw.Text}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="pressed">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Cw.GlowPress}" />
                                <Setter Property="Foreground" Value="{DynamicResource Cw.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Cw.AlertHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Cw.Text}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Cw.AlertPress}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- «AJUSTES» en la barra, como en la maqueta: icono de deslizadores y texto en mono, en oro. -->
        <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{DynamicResource Cw.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Cw.GlowHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Cw.GlowPress}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="{DynamicResource Cw.AccentEdge}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Cw.Background}" BorderBrush="{DynamicResource Cw.Line}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Image Source="Assets/logo-64.png" Width="24" Height="24"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <!-- «Cryptwire» en Grenze Gotisch, dibujada por tools/generar-marca.ps1 (WPF no usa fuentes variables). -->
                        <Image Source="Assets/marca.png" Height="21" Margin="10,0,0,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect Color="{DynamicResource Cw.AccentColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.35" />
                            </Image.Effect>
                        </Image>
                        <TextBlock x:Name="SkinTag" Margin="16,2,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource MetaFont}" FontSize="11"
                                   Foreground="{DynamicResource Cw.Faint}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="SettingsButton" Style="{StaticResource SettingsButton}" Click="OnSettings"
                                ToolTip="Ajustes de Cryptwire" AutomationProperties.Name="Ajustes de Cryptwire" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M0,2.5 H12 M0,8.5 H12 M3.5,0.5 V4.5 M8.5,6.5 V10.5" Width="12" Height="11"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="SettingsLabel" Margin="9,1,0,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource MetaFont}" FontSize="11" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="OnMinimize"
                                ToolTip="Minimizar" AutomationProperties.Name="Minimizar">
                            <Path Data="M0,0.5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" SnapsToDevicePixels="True" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource MaximizeButton}" Click="OnMaximize"
                                ToolTip="Maximizar" AutomationProperties.Name="Maximizar">
                            <Path x:Name="MaximizeIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" SnapsToDevicePixels="True" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Click="OnClose"
                                ToolTip="Cerrar" AutomationProperties.Name="Cerrar">
                            <Path Data="M0,0 L10,10 M10,0 L0,10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- WhatsApp y los widgets: la barra abajo, a todo el ancho, o el panel a la derecha, a toda la altura.
                 Van al lado de WebView2, nunca encima: WPF no puede pintar sobre la ventana del navegador. -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <wv2:WebView2 x:Name="WebView" Grid.Row="0" Grid.Column="0" DefaultBackgroundColor="#02040A" />
                <app:WidgetPanel x:Name="WidgetPanel" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Visibility="Collapsed" />
                <app:WidgetBar x:Name="WidgetBar" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>
</Window>
